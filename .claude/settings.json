{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "D:/Research Paper/.venv/Scripts/python.exe",
            "args": ["D:/Research Paper/scripts/log_command.py"],
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "D:/Research Paper/.venv/Scripts/python.exe",
            "args": ["D:/Research Paper/scripts/log_command.py"],
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  }
}
